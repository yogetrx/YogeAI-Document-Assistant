# Azure OpenAI (Azure endpoint for the Azure OpenAI resource, not necessarily an AI Foundry project endpoint)
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=replace_me
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=YOUR_CHAT_DEPLOYMENT_NAME

# Alternative: OpenAI API (leave Azure variables blank)
# OPENAI_API_KEY=replace_me
# OPENAI_MODEL=gpt-4o-mini

# API settings
MAX_UPLOAD_MB=15
TOP_K_DEFAULT=4
